{
  "name": "dnt-dental",
  "version": "1.1.7",
  "private": true,
  "description": "DNT Dental Clinic Management System أ¢â‚¬â€‌ unified online & offline codebase",
  "workspaces": [
    "server",
    "client"
  ],
  "dependencies": {
    "@dnt/dental-server": "1.1.7"
  },
  "scripts": {
    "dev:server": "npm run start:dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev:online": "cross-env DEPLOYMENT_MODE=online npm run start:dev --workspace=server",
    "dev:offline": "cross-env DEPLOYMENT_MODE=offline npm run start:dev --workspace=server",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "build": "npm run build:server && npm run build:client",
    "build:online": "cross-env DEPLOYMENT_MODE=online npm run build",
    "build:offline": "cross-env DEPLOYMENT_MODE=offline npm run build",
    "typecheck:server": "npm run typecheck --workspace=server",
    "typecheck:client": "npm run typecheck --workspace=client",
    "typecheck": "npm run typecheck:server && npm run typecheck:client",
    "seed": "npm run seed --workspace=server",
    "start:prod": "npm run start:prod --workspace=server",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build",
    "release:sync-version": "powershell -ExecutionPolicy Bypass -File release/scripts/sync-version.ps1",
    "release:offline": "powershell -ExecutionPolicy Bypass -File release/scripts/build-release.ps1",
    "release:test-update": "powershell -ExecutionPolicy Bypass -File release/scripts/test-install-update.ps1",
    "release:test-licensing": "node release/scripts/test-offline-licensing.js",
    "release:test-license-rotation": "node release/scripts/test-license-key-rotation.js"
  },
  "devDependencies": {
    "cross-env": "^7.0.3"
  }
}
