# Copy to .env and adjust as needed.

# Deployment mode: offline (Windows desktop) | online (cloud browser)
DEPLOYMENT_MODE=offline

PORT=4000
HOST=0.0.0.0

# Serve the built UI from server/public (set to 0 for API-only)
SERVE_CLIENT=1

# SQLite database file (relative to server/ or absolute path)
DATABASE_FILE=./data/clinic.db

# Production data root — overrides DATABASE_FILE location (used by offline launcher)
# DNT_DATA_DIR=C:\ProgramData\DibNova\DNTDental

# JWT secret used to sign session tokens.
# REQUIRED in online mode — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=12h

# Online mode only — comma-separated browser origins for CORS
# CORS_ORIGINS=https://dentalnova.dibnova.com

# Online — Google Gemini (clinic data stays local; only chat messages/images sent to provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Offline — uses Dental Nova Online AI service. Leave AI_SERVICE_URL empty to disable.
# Clinic data stays local; only the LLM prompt/messages/image are sent.
# Use a unique secret shared with the Online server — never ship the public default
# DentalNova.AI.Proxy.v1 or the example placeholder REPLACE_WITH_UNIQUE_AI_PROXY_SECRET.
AI_SERVICE_URL=https://dentalnova.dibnova.com
AI_SERVICE_SECRET=REPLACE_WITH_UNIQUE_AI_PROXY_SECRET

# Same-clinic Online ↔ Offline change-sync is configured in the app (Settings),
# not with a permanent secret in this file. Device credentials are written to
# {DNT_DATA_DIR}/config/sync-device.json after pairing.

# Optional Cloudflare R2 (usually Online only; Offline falls back to local files)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=
# R2_BUCKET=dentalnova-files

# DibNova admin API key — required for online subscription management endpoints
# Used by the existing DibNova admin system (header: X-DibNova-Admin-Key)
DIBNOVA_ADMIN_API_KEY=

# Offline updates — GitHub Releases repository (owner/name)
GITHUB_RELEASES_REPO=m7ameddib/DentalNova

# Optional — pin Authenticode publisher (substring match on the signed Subject)
# UPDATE_AUTHENTICODE_PUBLISHER=DibNova
# ALLOW_UNSIGNED_UPDATES is ignored. Windows always requires Authenticode Status = Valid.

# Optional — GitHub token for higher API rate limits when checking/downloading releases
# GITHUB_TOKEN=

# Offline online activation — DibNova licensing server base URL (HTTPS)
DIBNOVA_LICENSING_URL=https://dental.dibnova.com

# Licensing server only — path or PEM content for offline license signing (never ship to clinics)
# DNT_LICENSE_PRIVATE_KEY=keys/license-private.pem
