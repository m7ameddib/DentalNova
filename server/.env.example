# Copy to .env and adjust as needed.

PORT=4000



# Local SQLite database file (offline-first). Path is relative to server/.

DATABASE_FILE=./data/clinic.db



# JWT secret used to sign local session tokens.

JWT_SECRET=change-this-in-production

JWT_EXPIRES_IN=12h



# Optional — AI Assistant via Google Gemini (clinic data stays local; only chat messages/images sent to provider)

GEMINI_API_KEY=

GEMINI_MODEL=gemini-3.6-flash



# Reserved for future online sync (not used in this phase).

SYNC_ENABLED=false

SYNC_REMOTE_URL=

