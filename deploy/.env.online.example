# DentalNova Online — copy to .env in the project root before docker compose up

DEPLOYMENT_MODE=online
NODE_ENV=production
SERVE_CLIENT=1
PORT=4000
HOST=0.0.0.0

# REQUIRED — generate a unique secret per deployment:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=REPLACE_WITH_STRONG_SECRET
JWT_EXPIRES_IN=12h

# Persistent data directory inside the container
DNT_DATA_DIR=/data

# Public domain (used by Caddy for automatic HTTPS)
DOMAIN=dentalnova.dibnova.com

# CORS — must match the public URL users open in the browser
CORS_ORIGINS=https://dentalnova.dibnova.com

# AI assistant (Gemini 3.5 Lite). Also serves Offline clinics via /api/ai-provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_SERVICE_SECRET=DentalNova.AI.Proxy.v1

# DibNova admin — server-side credentials (never enter in the browser)
DIBNOVA_ADMIN_USERNAME=admin
DIBNOVA_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Optional — automation/scripts only (not shown in the UI)
DIBNOVA_ADMIN_API_KEY=REPLACE_WITH_STRONG_ADMIN_KEY
DIBNOVA_ADMIN_JWT_EXPIRES_IN=8h
