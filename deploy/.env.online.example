# DentalNova Online — copy to .env in the project root before docker compose up

DEPLOYMENT_MODE=online
NODE_ENV=production
SERVE_CLIENT=1
PORT=4000
HOST=0.0.0.0

# REQUIRED — generate a unique secret per deployment:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=REPLACE_WITH_STRONG_SECRET
JWT_EXPIRES_IN=12h

# Persistent data directory inside the container
DNT_DATA_DIR=/data

# Public domain (used by Caddy for automatic HTTPS)
DOMAIN=dentalnova.dibnova.com

# CORS — must match the public URL users open in the browser
CORS_ORIGINS=https://dentalnova.dibnova.com

# AI assistant (Gemini). Leave GEMINI_API_KEY empty unless you also set a unique
# AI_SERVICE_SECRET. The process will not boot if GEMINI_API_KEY is set and the
# secret is missing, DentalNova.AI.Proxy.v1, or this example placeholder.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_SERVICE_SECRET=REPLACE_WITH_UNIQUE_AI_PROXY_SECRET

# Clinic self-signup: open | invite | disabled. Production Online defaults to invite.
# ONLINE_CLINIC_SIGNUP=invite

# Cloudflare R2 (server-side only). Bucket default: dentalnova-files
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=
# R2_BUCKET=dentalnova-files
# R2_REGION=auto
# R2_PREFIX=
# PUBLIC_ONLINE_URL=https://dentalnova.dibnova.com
# PLATFORM_SECRETS_KEY is required in production Online (do not reuse JWT_SECRET)
PLATFORM_SECRETS_KEY=REPLACE_WITH_UNIQUE_PLATFORM_SECRETS_KEY

# DibNova admin — server-side credentials (never enter in the browser)
DIBNOVA_ADMIN_USERNAME=admin
DIBNOVA_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Optional — automation/scripts only (not shown in the UI). Minimum 16 characters.
DIBNOVA_ADMIN_API_KEY=REPLACE_WITH_STRONG_ADMIN_KEY
DIBNOVA_ADMIN_JWT_EXPIRES_IN=8h
